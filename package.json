{
  "name": "mtg-show-and-tell-mirror",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Online implementation of the Show and Tell mirror format (Timeless), where both players run the same 60-card deck.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-serverless.mjs && vite build",
    "preview": "vite preview",
    "server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "selfhost": "npm run build && npm run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync:cards": "tsx scripts/sync-cards.ts",
    "gen:data": "node scripts/gen-data.mjs",
    "check:serverless": "node scripts/check-serverless.mjs",
    "set:art": "tsx scripts/set-art.ts",
    "ai:arena": "tsx scripts/ai-arena.ts",
    "ai:bench": "tsx scripts/ai-bench.ts",
    "ai:compare": "tsx scripts/ai-compare.ts",
    "ai:fit-eval": "tsx scripts/ai-fit-eval.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
